# Nebius Token Factory (OpenAI-compatible) — optional.
# If unset, the app uses a deterministic local mock coach.
VITE_NEBIUS_API_KEY=
# Defaults to the vite dev-proxy path "/api/nebius". Override with a full URL
# (e.g. https://api.tokenfactory.nebius.com/v1) when serving outside vite dev.
VITE_NEBIUS_BASE_URL=
# Coaching model. Default moonshotai/Kimi-K3 (text-only reasoning model).
# Vision-capable alternatives on Token Factory: google/gemma-3-27b-it, openbmb/MiniCPM-V-4_5.
VITE_NEBIUS_MODEL=moonshotai/Kimi-K3
# "true" sends keyframe images to the model (only for vision-capable models).
VITE_NEBIUS_VISION=false

# Supabase (M2 auth/history) — anon key is safe for client use.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
